# Copy to .env (gitignored) and fill in. Loaded by `s2m` on start.

# Hosted models
OPENROUTER_API_KEY=          # https://openrouter.ai/keys  (set a credit limit on the key, e.g. $5). The only key the default setup needs.
GEMINI_API_KEY=              # optional: https://aistudio.google.com/apikey  (unbilled project = free tier). Backup reader and "Explain this" cloud fallback.

# Spend caps (USD), checked before every paid call. Local/free backends are never capped.
S2M_MAX_USD_PER_JOB=1.00
S2M_MAX_USD_PER_MONTH=5.00

# Web app worker (`s2m worker`): Supabase project URL and service-role key (server-side only!)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
