# Vercel project env vars (and web/.env.local for `pnpm dev`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only: API routes (quotas, uploads, jobs)
GEMINI_API_KEY=                   # cloud fallback for "Explain this" when the laptop worker is offline
GEMINI_EXPLAIN_MODEL=gemini-3.1-flash-lite
ADMIN_TOKEN=                      # open /admin?token=... to see jobs and spend
OPENROUTER_API_KEY=               # per-section "Enhance" rewrites (server only; DeepSeek V3.2 by default)
REWRITE_MODEL=deepseek/deepseek-v3.2
